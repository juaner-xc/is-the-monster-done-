class_name Ch02Lines
extends RefCounted
## 第二章对白数据。
## 只放文本，不放逻辑：每条是 {who, text, fx?}，who 为空表示旁白，fx 交给场景做演出。
##
## 剧本口径：《新流程》第二章（初见 → 车撞 → 站台关阀 → 仓库 → 备战选择 → 旧帐篷 →
## 千席宴炉 → 升降台后方的裂隙）。初见的过程由影片 taotao_meeting.ogv 演完，
## 场景内只补「拿饭盒 + 摊地图 + 卸货铃」三件事。
##
## 文风约定：旁白只说画面和动作，不解释人物心理；台词只说人物此刻想要的东西，
## 不替任务卡和地图做说明。一次对话尽量不超过 8 行，超出的部分让玩家长按 F 追问。


## 初见（接影片之后）：饭盒、地图、山壁那一声卸货铃，然后是撞车。
static func taotao_first() -> Array:
	return [
		{"who": "", "text": "餐车停在坡口，车盖掀着。半扇旧烤炉门当桌面，上面摊着一张揉皱的地图。"},
		{"who": "奶蛙", "text": "我在找旧运输道。"},
		{"who": "陶陶", "text": "你是来领饭的吧？……锅盖呢？"},
		{"who": "奶蛙", "text": "路上弄丢了。"},
		{"who": "", "text": "她从车侧面摘下锅盖，挨个往你锅上比。一个比一个小。"},
		{"who": "陶陶", "text": "这口不对。这口也不对。"},
		{"who": "陶陶", "text": "汤要盖着才不跑味。你这么端回去，到地方就剩半锅。"},
		{"who": "陶陶", "text": "那先拿一份。今天多盛了一盒，本来想留到晚上。"},
		{"who": "", "text": "她从车斗里摸出一只带盖的饭盒，放在地图边上。", "fx": "quest"},
		{"who": "陶陶", "text": "这一片都叫火山洞窟。你们那边扔掉的东西，顺着运输线掉到这儿。"},
		{"who": "", "text": "她把地图往你这边推了推。", "fx": "map"},
		{"who": "陶陶", "text": "老肯说你今天到。先跟着我，把这最后一户送完。"},
		{"who": "", "text": "刚走出两步，岩壁高处响了一声卸货铃。", "fx": "bell"},
		{"who": "陶陶", "text": "这个点不该有铃……"},
		{"who": "", "text": "一辆装满废件的货车从弯道冲下来，撞在卸货台上。白汽喷出来，把站台的路和一户人家的楼梯一起罩住。", "fx": "alarm"},
		{"who": "小朋友", "text": "陶陶，我妈下不来！"},
		{"who": "", "text": "她把那口汤从灶上端下来。火灭了。"},
		{"who": "陶陶", "text": "你先去运输站，把三个喷气阀关掉。我把伤员和锅先挪开。"},
	]


## 第二次对话：只讲她为什么肯关主炉、以及先做什么。四地点顺序交给任务卡与地图。
static func taotao_briefing() -> Array:
	return [
		{"who": "陶陶", "text": "你在运输箱上看到的校印，也在终宴的检修图上。升降道底下有扇门，能通回你们的旧菜厨房。"},
		{"who": "陶陶", "text": "可升降道被主炉封住了。想下去，得先让它停下来。"},
		{"who": "陶陶", "text": "它也给这里供热、供饭。停了，我得先想好大家今晚吃什么。"},
		{"who": "陶陶", "text": "先关运输站的三个喷气阀，再清出轨道。仓库里那点能源，找到后带去备用小厨房。"},
	]


## 说完一遍之后再找她：一句话把人指回正事，不重复整段设定。
static func taotao_reminder() -> Array:
	return [
		{"who": "陶陶", "text": "运输站那边还等着人。三个阀，全关上。"},
	]


## 退休料理机械：可看、可听，不可用。
static func machine() -> Array:
	return [
		{"who": "", "text": "它的胸前托架里放着一只碗。"},
		{"who": "", "text": "夹钳动了一下，没能合拢。"},
		{"who": "", "text": "收音机里有很轻的电流声，像有人在很远的地方说话。"},
	]


## 生活区居民：短、碎、像真正在过日子的人说的话。
static func resident(key: String) -> Array:
	match key:
		"kid":
			return [
				{"who": "小孩", "text": "我妈在楼上。她腿不好。"},
				{"who": "小孩", "text": "陶陶说一会儿就上去背她。"},
			]
		"mother":
			return [
				{"who": "楼上的人", "text": "别上来，梯口的铁皮松了。"},
				{"who": "楼上的人", "text": "我就在这儿等。饭别凉了就行。"},
			]
		"resident_queue_b":
			return [
				{"who": "老人", "text": "排了两刻钟了。凉了也好，凉了也香。"},
				{"who": "老人", "text": "这队我认得。去年冬天也这么长。"},
			]
		"resident_queue_c":
			return [
				{"who": "居民", "text": "她说今天多煮了一锅。我就信她这一句。"},
				{"who": "居民", "text": "碗我带来了。别的没带。"},
			]
		"wounded":
			return [
				{"who": "摔在路边的人", "text": "……锅没洒。锅还在。"},
			]
		"resident_pipe":
			return [
				{"who": "居民", "text": "主炉一响，这根管子就烫。我们都不敢靠太近。"},
				{"who": "居民", "text": "可离远了又冷。"},
			]
		"resident_pair_a":
			return [
				{"who": "居民", "text": "陶陶说今天有汤。"},
				{"who": "居民", "text": "不过我排在后面，能不能轮到还不好说。"},
			]
		"resident_queue":
			return [
				{"who": "居民", "text": "那台机器以前一次能揉二十个人的面。"},
				{"who": "居民", "text": "现在就搁在那儿，也没人搬走。"},
			]
		"resident_tent":
			return [
				{"who": "居民", "text": "中层大平台上那顶紫帐篷？那是早年一个魔法师扎的，谁也不敢动。"},
			]
	return [{"who": "居民", "text": "……"}]


## 仓库里的运输记录：近年的退货单、以及那批厨房旧稿的去向。
## 签名与「进去的车会空着回来」是全章最要紧的两条伏笔，保持原样。
static func record_pages() -> Array:
	return [
		{
			"title": "运输记录 · 近年",
			"body": "近年的退货单越来越厚。\n每一张都盖着终宴供货的印，退回来的东西却写着「不合用」。",
		},
		{
			"title": "运输记录 · 早年那张",
			"body": "早年那张是夜班炉的退货单。\n收货人一栏写着「肯德齐」，签得很快，像是顺手。\n\n背面补了一行小字：\n「货已退，炉照旧。」\n\n同一车还记着几份厨房旧稿，去向是「升降道尽头的封闭闸门」。\n下面是不同年月的笔迹，铅笔补了一句：\n「卸到闸外即可。进去的车会空着回来。」",
		},
	]


## 帐篷里的日记：一个做汤的人留下的三则。最后附着他画的那张图。
static func diary_pages() -> Array:
	return [
		{
			"title": "日记 · 第七天",
			"body": "向导只把我们送到桥头。\n再往里，他说什么都不去了。\n\n雪原那口炉子，烧不到火候。\n我试了三种柴，都不行。",
		},
		{
			"title": "日记 · 第十九天",
			"body": "夜班只剩两个人。\n我们一起给那锅汤添水，添到天亮。\n\n还差半格。\n就差半格。",
		},
		{
			"title": "日记 · 最后一页",
			"body": "借小灶热了一下，补上了最后半格。\n夜班换人，我把锅留下。\n\n小碗明天还。\n——如果有人替我端过去，那道菜应该就成了。\n\n底下是一张画：魔法台，和它侧边那只阀。\n旁边一行字：\n「听见管里往回吸，就关侧阀。」",
		},
	]


## 《黄金食谱》：被撕去一页，最后一道术式只写了一半。
static func recipe_pages() -> Array:
	return [
		{
			"title": "黄金食谱 · 扉页",
			"body": "一本用油布包着的旧书，书脊上没有名字。\n\n夹着两张药铺的欠条，日期都是同一年的秋天。\n有一页被撕掉了，撕口很齐。",
		},
		{
			"title": "黄金食谱 · 那道菜",
			"body": "「先撤火，等响声停了再下料。」\n\n下面是一遍又一遍的试做记录：\n第一次散了一地，第二次糊在锅底，第三次，散掉的食材自己收拢了回来。\n\n页边写着一行小字：\n「下次我端过去，他总该尝一口了吧。」",
		},
		{
			"title": "黄金食谱 · 最后一页",
			"body": "最后一道术式只写了一半。\n步骤停在一半的地方，字迹断得很干脆。\n\n页脚：\n「终宴试做。后半页放在大厅，回去再誊。」",
		},
	]


## 做汤：魔法台上的表针与那只侧阀。规则说明交给下面的选择卡。
static func soup_gauge() -> Array:
	return [
		{"who": "", "text": "魔法台的表针慢慢走到第一格，汤面开始转。"},
	]


static func soup_overboiled() -> Array:
	return [
		{"who": "", "text": "表针压过半格。管子先是一静，接着把整锅汤往回吸。"},
		{"who": "", "text": "头顶那盏保温灯暗了下去。"},
		{"who": "奶蛙", "text": "……往回吸。关侧阀。"},
	]


static func soup_saved() -> Array:
	return [
		{"who": "", "text": "侧阀合上。管里的回吸声断在半路。"},
		{"who": "", "text": "保温灯重新亮起来，比刚才还稳。"},
	]


static func soup_done() -> Array:
	return [
		{"who": "", "text": "你把汤装进随身的小锅。笔记里写着：趁热。", "fx": "soup"},
	]


## 帐篷外：陶陶只知道那盏灯和那道会响的墙。具体的事留给裂隙现场。
static func taotao_tent_hint() -> Array:
	return [
		{"who": "陶陶", "text": "紫布金顶，扎得比我们的工棚讲究多了。我上来第一眼就看见它。"},
		{"who": "陶陶", "text": "升降台背后那道岩壁，最近又开始响了。"},
		{"who": "奶蛙", "text": "响？"},
		{"who": "陶陶", "text": "像有人在里面摆桌子。"},
	]


## 章末：主炉停下之后的两套世界状态，最后都收到那本手稿上。
static func taotao_ending(energy: String) -> Array:
	var opening: Array
	if energy != "pot":
		opening = [
			{"who": "", "text": "主炉停了。小灶那口汤重新滚起来，蒸汽把锅盖顶得轻轻响。"},
			{"who": "", "text": "陶陶端着碗在门口站了一会儿，先去看那个还没找到另一只手套的孩子。"},
			{"who": "陶陶", "text": "水开了。"},
			{"who": "", "text": "她说这句话的时候，像是把一件拖了很久的事放回了原处。"},
		]
	else:
		opening = [
			{"who": "", "text": "主炉停了。生活区还有几户在等热饭，管子的余温撑不了多久。"},
			{"who": "", "text": "陶陶把最后一箱补给往前推了一段，停下来喘了口气。"},
			{"who": "陶陶", "text": "还有几户。帮我把最后这一段推过去？"},
		]
	opening.append_array([
		{"who": "陶陶", "text": "你在帐篷里找到的那本，我看过了。前面写的我都认得，是我照着做过的那张残页。"},
		{"who": "陶陶", "text": "最后一道术式只写了一半。页脚说，后半页放在大厅。"},
		{"who": "奶蛙", "text": "大厅。终宴那个大厅？"},
		{"who": "陶陶", "text": "升降道往上，就是那儿。你要是真能上去，替我把后半页看一眼。"},
		{"who": "", "text": "她从口袋里摸出一盏检修灯，塞进你手里。"},
		{"who": "陶陶", "text": "拿着。升降台后面那道墙，最近不对劲。"},
		{"who": "", "text": "任务 · 去升降台", "fx": "quest"},
	])
	return opening


## 支阀段之一：奶蛙回到生活区，看见她还在跟那只手较劲。
static func taotao_stuck() -> Array:
	return [
		{"who": "", "text": "陶陶还蹲在主炉接口前面。她的手卡在滚烫的接头上，正用另一只手把它硬掰回去。"},
		{"who": "奶蛙", "text": "你先停一下，叫别人来吧。"},
		{"who": "陶陶", "text": "他们那边也有活。我熟，快一点。"},
		{"who": "奶蛙", "text": "你刚才还说，做不了了也可以歇着。"},
		{"who": "", "text": "她没接话，低头把扳手捡起来。"},
		{"who": "陶陶", "text": "这根接完就歇。"},
	]


## 支阀段之二：她把图纸交给别人。
static func taotao_rested() -> Array:
	return [
		{"who": "", "text": "支阀合上了。接口那圈红光一点点暗下去。"},
		{"who": "", "text": "陶陶在长凳边坐下，把那台旧料理机械叫了过来。"},
		{"who": "陶陶", "text": "这个接口，你看这里。压力上来的时候，先关这个。"},
		{"who": "", "text": "机器人的夹钳动了一下。"},
		{"who": "", "text": "这一次，合上了。"},
	]


## 支阀段之后：她的语气变了。
static func taotao_after_rest() -> Array:
	return [
		{"who": "陶陶", "text": "接口那边交给它了。它做得慢，但做得对。"},
		{"who": "陶陶", "text": "……我坐一会儿。你要走的时候叫我。"},
	]


## 战前（小厨房分流接好之后）：她在通话管那头，说明这一战怎么打。
static func taotao_boss_brief() -> Array:
	return [
		{"who": "", "text": "墙上的通话管响了。"},
		{"who": "陶陶", "text": "它又开始抽热了。"},
		{"who": "陶陶", "text": "听见管子往回响，就去关场边的阀。它缓不过来那几秒，你再上去打。"},
		{"who": "奶蛙", "text": "关哪一个？"},
		{"who": "陶陶", "text": "挑近的那个。两个都关上，它能趴更久。"},
	]


## 能源接好之后，陶陶的反应。两句都不责备，只是她接下来要面对的东西不同。
static func taotao_energy_reaction(branch: String) -> Array:
	if branch == "stove":
		return [
			{"who": "", "text": "管道里传来陶陶的声音。"},
			{"who": "陶陶", "text": "好，我来接。仓库里还剩些食材，你挑一点再进去。"},
			{"who": "", "text": "灶台一盏一盏亮起来。有人端着锅从走廊那头跑过来。"},
		]
	return [
		{"who": "", "text": "管道里传来陶陶的声音。"},
		{"who": "陶陶", "text": "那就接你的锅。主炉停下来以后……再想办法。"},
		{"who": "", "text": "她停了一下，没有再说别的。"},
	]


## 有取餐铃的路线：旧送餐机械载着奶蛙穿过生活区，直接到陶陶的餐车边。
## 「两条路最后都见到陶陶」，铃声只提供便利和不同对白，不决定善恶。
static func bell_arrival() -> Array:
	return [
		{"who": "", "text": "旧送餐机械的轮子碾过地面，慢慢停在餐车边。"},
		{"who": "陶陶", "text": "这铃声……仓库那边的老机械还在用？"},
		{"who": "奶蛙", "text": "有人给我的。"},
		{"who": "陶陶", "text": "那正好。这边正缺一台会跑腿的。"},
	]


## 裂隙：岩壁那一头是自家厨房。
static func rift_check() -> Array:
	return [
		{"who": "", "text": "岩壁上有一道细缝，光从里面透出来，落在地上是一条不规则的亮边。"},
		{"who": "", "text": "你把检修灯贴近裂缝。里面先是一静，然后是一声盖不严的锅盖响。磕了两下，在左边。"},
		{"who": "奶蛙", "text": "……那是我家的锅盖。"},
		{"who": "", "text": "缝开了一线。你看得见桌角、挂在一边的擦手布，和灶上那口还在冒热气的汤。"},
	]


static func rift_crossed() -> Array:
	return [
		{"who": "", "text": "你侧身挤进裂缝。脚跟刚离开铁轨，身后的石壁就合上了。"},
		{"who": "", "text": "厨房里那口汤，还在冒热气。", "fx": "ending"},
	]


## 生活区里「能被看一眼」的东西。key 与 Ch02Prop.prop_key 一一对应。
## 原则不变：只说画面和动作，不解释。玩家看完应该能自己接上台词。
static func prop(key: String) -> Array:
	match key:
		"cart_lid":
			return [
				{"who": "", "text": "车盖是半扇旧烤炉门，铰链在车尾。内侧熏得发黄，正好当桌面。"},
				{"who": "", "text": "地图不是画上去的，是刮出来的：粉笔线、机油印，还有几处按得太重留下的凹痕。"},
				{"who": "", "text": "东边那条线一路划到纸边，断了。"},
			]
		"pot_lids":
			return [
				{"who": "", "text": "车侧面挂着三个锅盖，一个比一个圆，一个比一个小。"},
				{"who": "", "text": "最小的那个还没掌心大。"},
			]
		"lunch_box":
			return [
				{"who": "", "text": "带扣的铝饭盒，盖子压得严严的。"},
				{"who": "", "text": "底下垫着一层布，还是热的。"},
			]
		"cart_pot":
			return [
				{"who": "", "text": "车斗里腾出一小块地方，架着一口小锅。"},
				{"who": "", "text": "风从坡口灌进来，火苗被压得贴着锅底。锅沿一直没开。"},
			]
		"dock_bell":
			return [
				{"who": "你", "text": "铃上还挂着一段断绳。刚才那声响得太近，不像从山那边来的。"},
			]
		"dock_wreck":
			return [
				{"who": "你", "text": "车斗是空的，轮子还在转。这一车废件是从山上滑下来的。"},
				{"who": "你", "text": "撞上卸货台的那一下，把分流阀顶歪了。"},
			]
