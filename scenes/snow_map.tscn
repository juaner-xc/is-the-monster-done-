[sub_resource type="Shader" id="Shader_glass"]
code = "shader_type spatial;
render_mode unshaded, blend_mix, cull_disabled, depth_draw_never;
uniform vec4 field_color : source_color = vec4(0.45, 0.72, 1.0, 1.0);
uniform float wall_height = 60.0;
uniform float strength = 0.35;
varying float v_h;
varying vec3 v_pos;
void vertex() { v_h = VERTEX.y; v_pos = VERTEX; }
void fragment() {
float t = clamp((v_h + wall_height * 0.5) / wall_height, 0.0, 1.0);
float fade = pow(1.0 - t, 1.3);
float rim = smoothstep(0.12, 0.0, t) * 0.3;
float stripe = 0.88 + 0.12 * sin(v_pos.x * 0.3 + v_pos.z * 0.3);
ALBEDO = field_color.rgb;
ALPHA = clamp((strength * fade + rim) * stripe, 0.0, 0.85);
}"

[sub_resource type="Shader" id="Shader_mist"]
code = "shader_type spatial;
render_mode unshaded, blend_mix, cull_disabled, depth_draw_never;
uniform vec4 mist_color : source_color = vec4(0.86, 0.93, 1.0, 1.0);
uniform vec4 line_color : source_color = vec4(0.35, 0.62, 1.0, 1.0);
uniform float inner = 340.0;
uniform float outer = 400.0;
varying vec3 v_wpos;
void vertex() { v_wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz; }
void fragment() {
float r = length(v_wpos.xz);
float t = smoothstep(inner, outer, r);
float line = smoothstep(8.0, 2.0, abs(r - 396.0));
vec3 col = mix(mist_color.rgb, line_color.rgb, line);
ALBEDO = col;
ALPHA = max(t * 0.8, line * 0.95);
}"

