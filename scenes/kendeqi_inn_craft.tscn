[sub_resource type="Shader" id="Shader_tlw2a"]
code = "
shader_type spatial;
render_mode cull_disabled;
void fragment() {
	float row=floor(UV.y*2.6);
	vec2 p=vec2(UV.x*2.05+mod(row,2.0)*0.5, UV.y*2.6);
	vec2 cell=floor(p);
	vec2 edge=fract(p);
	float rand=fract(sin(dot(cell,vec2(127.1,311.7)))*43758.5453);
	float joint=smoothstep(0.009,0.04,min(edge.x,1.0-edge.x))*smoothstep(0.01,0.075,edge.y);
	float ledge=smoothstep(0.0,0.09,edge.y)*(1.0-smoothstep(0.17,0.46,edge.y));
	ALBEDO=mix(vec3(0.023,0.033,0.056),mix(vec3(0.06,0.093,0.157),vec3(0.16,0.217,0.298),rand)+0.043*ledge,joint);
	ROUGHNESS=0.92;
}"

