[sub_resource type="Shader" id="Shader_water"]
code = "shader_type spatial;
render_mode unshaded, blend_mix, cull_disabled, depth_draw_never;
uniform sampler2D water_tex : source_color, filter_linear_mipmap, repeat_enable;
uniform vec4 deep_color : source_color = vec4(0.05, 0.22, 0.48, 1.0);
uniform vec4 shallow_color : source_color = vec4(0.35, 0.68, 0.90, 1.0);
uniform float opacity : hint_range(0.0, 1.0) = 0.8;
uniform vec2 flow_a = vec2(0.025, -0.045);
uniform vec2 flow_b = vec2(-0.015, 0.03);
varying vec3 v_world;
void vertex() {
v_world = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}
void fragment() {
vec2 uv = v_world.xz / 14.0;
vec3 t1 = texture(water_tex, uv + TIME * flow_a).rgb;
vec3 t2 = texture(water_tex, uv * 1.9 + vec2(0.37, 0.62) + TIME * flow_b).rgb;
vec3 tex = mix(t1, t2, 0.5);
float lum = dot(tex, vec3(0.333));
vec3 col = mix(deep_color.rgb, shallow_color.rgb, smoothstep(0.25, 0.8, lum));
ALBEDO = col;
ALPHA = opacity;
}"

