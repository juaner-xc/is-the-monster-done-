[sub_resource type="Shader" id="Shader_04o6r"]
code = "
shader_type spatial;
uniform vec4 tone : source_color = vec4(.38,.24,.16,1.0);
uniform int axis=1;
varying vec3 local_p;
void vertex(){
	local_p=VERTEX+(MODEL_MATRIX*vec4(VERTEX,1.0)).xyz*0.013;
}
void fragment(){
	float run=axis==0 ? local_p.x : (axis==2 ? local_p.z : local_p.y);
	vec2 across=axis==0 ? local_p.yz : (axis==2 ? local_p.xy : local_p.xz);
	float fold=sin(run*1.45+across.x*7.1)*.38+sin(run*6.0+across.y*3.6)*.12;
	float ripple=sin((across.x+across.y*.61)*107.0+fold*4.6);
	float pores=smoothstep(.74,1.0,ripple)*.12;
	float bands=sin((across.x+across.y*.81)*26.5+fold*3.0)*.065;
	ALBEDO=tone.rgb*(1.065-pores+bands);
	ROUGHNESS=.81+pores;
}"

