class_name Ch02Lines
extends RefCounted
## 第二章对白数据。
## 只放文本，不放逻辑：每条是 {who, text, fx?}，who 为空表示旁白，fx 交给场景做演出。

## 陶陶初遇：剧本第一段原文。这段同时完成轻松、态度、主炉故障预告三件事。
static func taotao_first() -> Array:
	return [
		{"who": "", "text": "陶陶往一台旧料理机械的碗里倒了一勺油。"},
		{"who": "奶蛙", "text": "机械也要吃饭？"},
		{"who": "陶陶", "text": "它这碗是油。你要汤的话，拿另一边的。"},
		{"who": "", "text": "奶蛙默默把伸出去的勺子收回来。"},
		{"who": "", "text": "旧机械试着接碗，夹钳却合不拢。陶陶把碗放进它胸前的托架。"},
		{"who": "奶蛙", "text": "它的手坏了？"},
		{"who": "陶陶", "text": "嗯。配套零件找不到了。"},
		{"who": "奶蛙", "text": "那它现在还能做什么？"},
		{"who": "陶陶", "text": "以前揉面，现在喜欢坐在这儿听收音机。"},
		{"who": "奶蛙", "text": "我是说……工坊里的工作。"},
		{"who": "", "text": "陶陶看了他一眼。"},
		{"who": "陶陶", "text": "它已经做不了了。"},
		{"who": "", "text": "她把餐车往前推了一点。"},
		{"who": "陶陶", "text": "总不能因为这个，连饭也不分给它吧。"},
		{"who": "", "text": "远处传来主炉的警报声。陶陶手里的勺子碰了一下碗沿。", "fx": "alarm"},
		{"who": "陶陶", "text": "又提前了……昨天还没这么快。"},
		{"who": "", "text": "她把剩下的饭交给旁边的居民，转身去看压力表。"},
	]


## 第二次对话：解锁四个地点，说明为什么主炉不能直接炸。
static func taotao_briefing() -> Array:
	return [
		{"who": "陶陶", "text": "升降道被主炉封住了。想下去，得先让它停下来。"},
		{"who": "奶蛙", "text": "那就把它关掉。"},
		{"who": "陶陶", "text": "它也给这里供热、供饭。停了，我得先想好大家吃什么。"},
		{"who": "", "text": "她用指节敲了敲压力表。"},
		{"who": "陶陶", "text": "我标了几个地方：熔岩运输站、原料仓库、备用小厨房，最后才是主炉控制区。"},
		{"who": "奶蛙", "text": "为什么是最后？"},
		{"who": "陶陶", "text": "因为你得先有办法让它停下来。"},
		{"who": "", "text": "她把餐车往东推了推，让开了门口。"},
		{"who": "陶陶", "text": "先去熔岩运输站。喷气阀不关，谁也过不去。"},
	]


## 退休料理机械：可看、可听，不可用。
static func machine() -> Array:
	return [
		{"who": "", "text": "它的胸前托架里放着一只碗。"},
		{"who": "", "text": "夹钳动了一下，没能合拢。"},
		{"who": "奶蛙", "text": "……"},
		{"who": "", "text": "收音机里有很轻的电流声，像有人在很远的地方说话。"},
	]


## 生活区居民：短、碎、像真正在过日子的人说的话。
static func resident(key: String) -> Array:
	match key:
		"resident_pipe":
			return [
				{"who": "居民", "text": "主炉一响，这根管子就烫。我们都不敢靠太近。"},
				{"who": "居民", "text": "可离远了又冷。"},
			]
		"resident_pair_a":
			return [
				{"who": "居民", "text": "陶陶说今天有汤。"},
				{"who": "居民", "text": "不过我排在后面，能不能轮到还不好说。"},
			]
		"resident_pair_b":
			return [
				{"who": "居民", "text": "……（她好像更想听旁边那个人说完）"},
			]
		"resident_queue":
			return [
				{"who": "居民", "text": "那台机器以前一次能揉二十个人的面。"},
				{"who": "居民", "text": "现在就搁在那儿，也没人搬走。"},
			]
		"resident_tent":
			return [
				{"who": "居民", "text": "已经很久没人往上面报修了。"},
			]
	return [{"who": "居民", "text": "……"}]


## 章末：主炉停下之后的两套世界状态，最后都收到残页上。
static func taotao_ending(energy: String) -> Array:
	var opening: Array
	if energy == "stove":
		opening = [
			{"who": "", "text": "主炉停了。居民把锅搬到小备灶那边，一个接一个地分饭。"},
			{"who": "", "text": "陶陶端着自己那份坐下，才发现饭已经凉了。"},
			{"who": "陶陶", "text": "……"},
			{"who": "", "text": "她吃了一口，还是继续吃。"},
		]
	else:
		opening = [
			{"who": "", "text": "主炉停了。居民在等临时补给，陶陶重新分配剩下的储备。"},
			{"who": "", "text": "她没说什么，只是把最后一箱往前推了推。"},
		]
	opening.append_array([
		{"who": "陶陶", "text": "这是以前留下的，照着做确实有用。"},
		{"who": "奶蛙", "text": "你不自己留着？"},
		{"who": "陶陶", "text": "我试过了，做不出所有人都需要的东西。"},
		{"who": "", "text": "她把残页递过来。"},
		{"who": "陶陶", "text": "如果你真找到了，回来告诉我，最后一页写了什么。"},
	])
	return opening


## 支阀段之一：奶蛙回到生活区，看见她还在跟那只手较劲。
static func taotao_stuck() -> Array:
	return [
		{"who": "", "text": "陶陶还蹲在主炉接口前面。她的手卡在滚烫的接头上，正用另一只手把它硬掰回去。"},
		{"who": "奶蛙", "text": "你先停一下，叫别人来吧。"},
		{"who": "陶陶", "text": "他们那边也有活。我熟，快一点。"},
		{"who": "奶蛙", "text": "你刚才还说，做不了了也可以歇着。"},
		{"who": "", "text": "她没接话，低头把扳手捡起来。"},
		{"who": "陶陶", "text": "这根接完就歇。"},
	]


## 支阀段之二：她把图纸交给别人。
static func taotao_rested() -> Array:
	return [
		{"who": "", "text": "支阀合上了。接口那圈红光一点点暗下去。"},
		{"who": "", "text": "陶陶在长凳边坐下，把那台旧料理机械叫了过来。"},
		{"who": "陶陶", "text": "这个接口，你看这里。压力上来的时候，先关这个。"},
		{"who": "", "text": "机器人的夹钳动了一下。"},
		{"who": "", "text": "这一次，合上了。"},
	]


## 支阀段之后：她的语气变了。
static func taotao_after_rest() -> Array:
	return [
		{"who": "陶陶", "text": "接口那边交给它了。它做得慢，但做得对。"},
		{"who": "陶陶", "text": "……我坐一会儿。你要走的时候叫我。"},
	]


## 能源接好之后，陶陶的反应。两句都不责备，只是她接下来要面对的东西不同。
static func taotao_energy_reaction(branch: String) -> Array:
	if branch == "stove":
		return [
			{"who": "", "text": "管道里传来陶陶的声音。"},
			{"who": "陶陶", "text": "好，我来接。仓库里还剩些食材，你挑一点再进去。"},
			{"who": "", "text": "灶台一盏一盏亮起来。有人端着锅从走廊那头跑过来。"},
		]
	return [
		{"who": "", "text": "管道里传来陶陶的声音。"},
		{"who": "陶陶", "text": "那就接你的锅。主炉停下来以后……再想办法。"},
		{"who": "", "text": "她停了一下，没有再说别的。"},
	]


## 有取餐铃的路线：旧送餐机械载着奶蛙穿过生活区，直接到陶陶的餐车边。
## 「两条路最后都见到陶陶」，铃声只提供便利和不同对白，不决定善恶。
static func bell_arrival() -> Array:
	return [
		{"who": "", "text": "旧送餐机械的轮子碾过地面，慢慢停在餐车边。"},
		{"who": "陶陶", "text": "这铃声……仓库那边的老机械还在用？"},
		{"who": "奶蛙", "text": "有人给我的。"},
		{"who": "陶陶", "text": "那正好。这边正缺一台会跑腿的。"},
	]
